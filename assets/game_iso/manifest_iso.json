    "dir": "masks/<staff>/<pose>.png",
    "format": "256x256 lossless PNG, pixel-aligned with game/staff/<staff>/<pose>.webp",
    "values_R": {
      "0": "background/other (outline, eyes, cups, props, accessories) - keep original colour",
      "1": "skin",
      "2": "hair (incl. beard)",
      "3": "top",
      "4": "bottom",
      "5": "shoes"
    },
    "recolor_hint": "per region: keep each pixel's lightness (cel-shade steps), replace hue/saturation with the target colour"
  }
